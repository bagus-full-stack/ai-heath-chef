<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- IA locale (flutter_gemma) : nécessaire pour l'inférence sur un
	     modèle de plusieurs Go sans crash mémoire. Rattaché au projet via
	     CODE_SIGN_ENTITLEMENTS (project.pbxproj) ; non testé sur un Mac : si la
	     signature échoue, vérifier les capacités dans Xcode (Signing & Capabilities). -->
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
</dict>
</plist>
